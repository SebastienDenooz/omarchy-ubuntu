#!/bin/bash
# Ubuntu: resets user configs to Omarchy defaults (copy of $OMARCHY_PATH/config, .bak backups).
set -euo pipefail
src="${OMARCHY_PATH:-/usr/share/omarchy}/config"
echo "Resetting user configs from $src…"
( cd "$src" && find . -type f | while read -r f; do
    dest="$HOME/.config/${f#./}"
    [[ -f $dest ]] && ! cmp -s "$f" "$dest" && cp -f "$dest" "$dest.bak.$(date +%s)"
    mkdir -p "$(dirname "$dest")"; cp -f "$f" "$dest"
  done )
command -v omarchy-nvim-setup >/dev/null && omarchy-nvim-setup --force || true
echo "Done. Replaced files have a .bak.<timestamp> copy."
