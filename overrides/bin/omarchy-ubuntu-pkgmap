#!/bin/bash
# Translates Arch package names into apt packages via $OMARCHY_PATH/ubuntu/pkgmap.txt.
# Output: one apt name per line; "SKIP" when there is no equivalent; the unchanged name otherwise.
map="${OMARCHY_PATH:-/usr/share/omarchy}/ubuntu/pkgmap.txt"
for pkg in "$@"; do
  m=$(grep -m1 "^$pkg=" "$map" 2>/dev/null | cut -d= -f2-)
  if [[ -z $m ]]; then echo "$pkg"; else for x in $m; do echo "$x"; done; fi
done
