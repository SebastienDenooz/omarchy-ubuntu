#!/bin/bash
# Ubuntu: update = newer Omarchy release (git merge on the ubuntu branch) + apt + mise + shell restart.
set -e
co=$(readlink -f "${OMARCHY_PATH:-/usr/share/omarchy}")
echo -e "\e[32m\nOmarchy (Ubuntu): checking releases\e[0m"
git -C "$co" fetch --tags origin
current=$(git -C "$co" describe --tags --abbrev=0)
latest=$(git -C "$co" tag -l 'v*' --sort=-v:refname | head -1)
if [[ -n $latest && $latest != "$current" ]]; then
  echo "New release: $current → $latest"
  if [[ ${1:-} == "-y" ]] || gum confirm "Merge $latest into the ubuntu branch?"; then
    git -C "$co" merge --no-edit "$latest" || { echo -e "\e[31mMerge conflict: resolve it in $co then run 'omarchy update' again.\e[0m"; exit 1; }
    omarchy-ubuntu-link-bins
    echo "Remember to re-run ~/omarchy-ubuntu/scripts/31-overrides.sh if Omarchy changed any overridden script."
  fi
else
  echo "Omarchy is up to date ($current)."
fi
echo -e "\e[32m\nUpdating Ubuntu packages\e[0m"
sudo apt-get update && sudo apt-get upgrade -y
omarchy-hook post-update
command -v omarchy-update-mise >/dev/null && omarchy-update-mise || true
omarchy-update-restart
