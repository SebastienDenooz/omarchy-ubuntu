#!/bin/bash
# Ubuntu: Install > Package menu → fuzzy search across apt packages.
fzf_args=(--multi --preview 'apt-cache show {1} 2>/dev/null | head -40' --preview-window 'down:65%:wrap'
  --preview-label='tab: multi-select · enter: install' --color 'pointer:green,marker:green')
pkg_names=$(apt-cache pkgnames | sort | fzf "${fzf_args[@]}")
if [[ -n $pkg_names ]]; then
  source omarchy-sudo-keepalive 2>/dev/null || true
  echo "$pkg_names" | tr '\n' ' ' | xargs sudo apt-get install -y
  omarchy-show-done
fi
