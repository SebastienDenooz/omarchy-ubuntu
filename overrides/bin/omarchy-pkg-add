#!/bin/bash
# Ubuntu: installs through apt (Arch names translated by ubuntu/pkgmap.txt).
to_install=(); skipped=()
for pkg in "$@"; do
  for p in $(omarchy-ubuntu-pkgmap "$pkg"); do
    if [[ $p == SKIP ]]; then skipped+=("$pkg"); continue; fi
    dpkg-query -W -f='${Status}' "$p" 2>/dev/null | grep -q 'install ok installed' || to_install+=("$p")
  done
done
if (( ${#to_install[@]} )); then
  if (( EUID == 0 )); then apt-get install -y --no-install-recommends "${to_install[@]}" || exit 1
  else sudo apt-get install -y --no-install-recommends "${to_install[@]}" || exit 1; fi
fi
if (( ${#skipped[@]} )); then
  echo -e "\033[33momarchy-pkg-add (Ubuntu): no apt equivalent for: ${skipped[*]}\033[0m" >&2
  echo "See ~/omarchy-ubuntu/MATRIX.md for how to proceed." >&2
  exit 1
fi
exit 0
